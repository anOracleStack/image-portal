NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Enable Google under Supabase → Authentication → Providers (add OAuth client ID/secret).
# Redirect URL must include https://rub.pub/auth/callback (see scripts/supabase-auth-rub-pub.sh).
SUPABASE_SERVICE_ROLE_KEY=          # server-only. NEVER expose to client/mobile.
# Local dev (use your port if 3000 is busy, e.g. http://localhost:3004)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production — set in Vercel → Settings → Environment Variables (Production):
# NEXT_PUBLIC_APP_URL=https://rub.pub
EMBED_MODEL_ID=dinov2_vitb14
EMBED_VERSION=1
CATALOG_EMBED_PROVIDER=together     # together | replicate | warm-endpoint
CATALOG_EMBED_API_KEY=
SAFE_BROWSING_API_KEY=
MAX_IMAGE_UPLOAD_MB=10

# Stripe (server-only). Get these from the Stripe Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INDIE=
STRIPE_PRICE_PRO=
