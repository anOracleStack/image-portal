# =============================================================================
# Image Portal (apps/web) — copy to .env.local and fill values you have.
# See docs/ENV_KEYS.md for where to get each key. Run: pnpm check:env
# =============================================================================

# --- Supabase (required) ---
# Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://duydupyyembdttmjvsxm.supabase.co
# Dashboard → Settings → API → anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Dashboard → Settings → API → service_role (server-only; never commit or expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# --- App URLs (required) ---
# Local dev uses port 3004 (see package.json "dev" script)
PORT=3004
NEXT_PUBLIC_APP_URL=http://localhost:3004
# Production (Vercel → Settings → Environment Variables):
# NEXT_PUBLIC_APP_URL=https://rub.pub

# --- Embedding / matching (required for real matches; grid works for demos) ---
EMBED_MODEL_ID=dinov2_vitb14
EMBED_VERSION=1
# grid = built-in MVP matcher (no external API). warm-endpoint = production ML service.
CATALOG_EMBED_PROVIDER=grid
# When CATALOG_EMBED_PROVIDER=warm-endpoint:
CATALOG_EMBED_ENDPOINT=
CATALOG_EMBED_API_KEY=

# --- AI chat (optional — workshop & help chat use rule-based fallback without this) ---
OPENAI_API_KEY=
# Optional model override (default gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# --- URL safety (optional) ---
# Google Cloud → Safe Browsing API key
SAFE_BROWSING_API_KEY=

# --- Upload limits ---
MAX_IMAGE_UPLOAD_MB=10

# --- Stripe billing (optional — subscriptions disabled without these) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_INDIE=
STRIPE_PRICE_PRO=
